+    for (int i = 0; i < (int)swizzleSequence.size(); ++i) {
+        const glslang::TIntermConstantUnion* cu =
+            swizzleSequence[i] ? swizzleSequence[i]->getAsConstantUnion() : nullptr;
+        if (cu == nullptr)
+            return false;
+        const int value = cu->getConstArray()[0].getIConst();
+        if (value < 0 || value >= 4)
+            return false;
+        swizzle.push_back(static_cast<unsigned>(value));
+    }
+    return true;
