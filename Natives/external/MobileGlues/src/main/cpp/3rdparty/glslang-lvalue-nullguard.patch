 // Convert a glslang AST swizzle node to a swizzle vector for building SPIR-V.
-void TGlslangToSpvTraverser::convertSwizzle(const glslang::TIntermAggregate& node, std::vector<unsigned>& swizzle)
+// Returns false when the selector is unusable (null/non-constant element or an
+// out-of-range index); swizzle is then left partially filled and the caller
+// falls back to the identity swizzle. Defensive against the iOS/arm64
+// selector-read corruption documented in lValueErrorCheck's guard.
+bool TGlslangToSpvTraverser::convertSwizzle(const glslang::TIntermAggregate& node, std::vector<unsigned>& swizzle)
